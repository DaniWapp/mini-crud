# =====================================================================
# Archivo:  mini-crud/.env.example
# Proyecto: Mini CRUD de usuarios
#
# Qué es:
#   La plantilla del archivo .env: los nombres de las variables con
#   valores de ejemplo. Este archivo SÍ se sube a GitHub; el .env con los
#   valores reales NO, porque contiene la contraseña de la base de datos.
#
# Cómo se usa:
#   1. Copie este archivo y llame a la copia ".env" (en la misma carpeta).
#   2. Cambie DB_PASSWORD por la contraseña real del usuario de MySQL.
# =====================================================================

# Dónde está el servidor de MySQL (este mismo equipo) y su puerto.
DB_HOST=127.0.0.1
DB_PORT=3306

# Nombre de la base de datos que crea database.sql.
DB_NAME=mini_crud

# Usuario y contraseña de MySQL con permisos sobre la base mini_crud.
DB_USER=mini_crud
DB_PASSWORD=cambia-esto
